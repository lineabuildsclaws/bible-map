{
  "name": "bible-map",
  "version": "0.1.0",
  "private": true,
  "description": "A quiet, interactive map for exploring biblical places.",
  "type": "module",
  "engines": {
    "node": ">=22.0.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "check": "npm run lint && npm run test && npm run build",
    "audit": "npm audit --audit-level=high",
    "licenses": "node scripts/generate-license-inventory.mjs"
  },
  "dependencies": {
    "maplibre-gl": "6.6.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.1",
    "eslint": "10.9.1",
    "globals": "17.11.0",
    "typescript": "7.0.2",
    "typescript-eslint": "8.68.0",
    "vite": "8.2.2",
    "vitest": "4.1.11"
  }
}
